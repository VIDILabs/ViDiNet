<div id="container">
    <div class="row">
        <div id="library" >
            <div id="logo-container" class="col-12 col-sm-12 col-md-3 col-lg-3">
            <img id="logo" src="/images/logo.png" alt="logo">
        </div>
            <!-- For each demo create a block -->
            {{#each libraryContent}}
                <a  href="#" class="demo-btn" onClick="updatePreview({{@index}})">
                    <div id="lib-icons-{{@index}}" class="icon-tab">
                        <img class="icon" src="/images/{{this.icon-img}}" alt="Icon">
                        <p id="demo-title">{{this.title}}</p>
                    </div>
                </a>
            {{/each}}
        </div>
        <div id="preview" class="col-10 offset-2 col-sm-10 offset-sm-2 col-md-10 offset-md-2 col-lg-10 offset-lg-2">
                {{> preview }}
        </div>
    </div>
</div>
